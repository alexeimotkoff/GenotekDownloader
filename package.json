{
  "name": "genotek-gedcom-export",
  "version": "1.0.6",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "alexeimotkoff",
  "description": "Chrome extension exporting Genotek genealogy graphs to GEDCOM 5.5.1",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "format": "prettier --write .prettierrc.json package.json \"extension/**/*.js\" \"demo/**/*.js\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\"",
    "format:check": "prettier --check .prettierrc.json package.json \"extension/**/*.js\" \"demo/**/*.js\" \"scripts/**/*.cjs\" \"tests/**/*.cjs\"",
    "check": "npm run format:check && node scripts/check.cjs",
    "demo": "node scripts/demo-server.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
